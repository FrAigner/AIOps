{
    "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
    "type": "app",
    "name": "AIOps Assistant",
    "id": "aiops-aiopsassistant-app",
    "backend": false,
    "preload": true,
    "info": {
        "keywords": [
            "app",
            "ai",
            "assistant",
            "chat"
        ],
        "description": "KI-Analyse-Chat fuer die AIOps-Plattform, angebunden an ein austauschbares OpenAI-kompatibles LLM-Backend.",
        "author": {
            "name": "Aiops"
        },
        "logos": {
            "small": "img/logo.svg",
            "large": "img/logo.svg"
        },
        "screenshots": [],
        "version": "1.0.0",
        "updated": "2026-08-08"
    },
    "includes": [
        {
            "type": "page",
            "name": "AI Assistant",
            "path": "/a/aiops-aiopsassistant-app/",
            "icon": "comment-alt",
            "addToNav": true,
            "defaultNav": true
        },
        {
            "type": "page",
            "icon": "cog",
            "name": "Configuration",
            "path": "/plugins/aiops-aiopsassistant-app",
            "role": "Admin",
            "addToNav": true
        }
    ],
    "dependencies": {
        "grafanaDependency": ">=12.3.0",
        "plugins": []
    },
    "extensions": {
        "addedComponents": [
            {
                "targets": [
                    "grafana/extension-sidebar/v0-alpha"
                ],
                "title": "AIOps Assistant",
                "description": "KI-Analyse-Chat fuer die AIOps-Plattform"
            }
        ],
        "addedLinks": [
            {
                "targets": [
                    "grafana/commandpalette/action"
                ],
                "title": "✨ AIOps Assistant öffnen",
                "description": "KI-Analyse-Chat oeffnen"
            }
        ]
    },
    "buildMode": "production"
}